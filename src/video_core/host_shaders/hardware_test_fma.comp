#version 450

// The hardware test's GPU workload: chains of fused multiply-adds, four independent vec4 chains so
// the ALUs stay busy, 256 floating point operations per loop and invocation. The result is written
// so the compiler cannot drop the work.

layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) writeonly buffer Result { float result[]; };
layout(push_constant) uniform Parameters { uint iterations; float seed; };

#define STEP a = fma(a, m, k); b = fma(b, m, k); c = fma(c, m, k); d = fma(d, m, k);

void main() {
    const uint id = gl_GlobalInvocationID.x;
    vec4 a = vec4(seed + float(id));
    vec4 b = a + 1.0;
    vec4 c = a + 2.0;
    vec4 d = a + 3.0;
    const vec4 m = vec4(0.99993);
    const vec4 k = vec4(0.00011);
    for (uint i = 0; i < iterations; ++i) {
        STEP STEP STEP STEP STEP STEP STEP STEP
    }
    result[id] = dot(a + b + c + d, vec4(1.0));
}
