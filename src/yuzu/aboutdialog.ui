       </item>
       <item>
        <widget class="QLabel" name="labelAbout">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Preferred" vsizetype="Preferred">
           <horstretch>0</horstretch>
           <verstretch>0</verstretch>
          </sizepolicy>
         </property>
         <property name="text">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Kaichii is JavocSoft's fork of Lichii: an experimental, open-source Nintendo Switch and Switch 2 emulator for laptops and modest graphics cards, with settings that explain themselves.&lt;/p&gt;&lt;p&gt;It builds on Lichii, Eglantine, Eden, yuzu and Sudachi, and on everyone who contributed to them.&lt;/p&gt;&lt;p&gt;This software should not be used to play games you have not legally obtained.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="alignment">
          <set>Qt::AlignmentFlag::AlignLeading|Qt::AlignmentFlag::AlignLeft|Qt::AlignmentFlag::AlignVCenter</set>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
